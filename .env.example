BROWNIE_LOCAL_DATABASE_URL=postgresql://brownie_local:replace_with_a_random_local_password@127.0.0.1:5434/brownie_local
BROWNIE_LOCAL_MAINTENANCE_KEY=replace_with_a_random_local_key
